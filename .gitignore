# =========================
# ENV FILES (SECRETS)
# =========================
.env
.env.*
!.env.example

# =========================
# DEPENDENCIES
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# BUILD OUTPUTS
# =========================
dist/
build/
.next/
out/
*.tsbuildinfo

# =========================
# CACHE / TEMP / LOGS
# =========================
.cache/
.eslintcache
coverage/
*.log

# =========================
# OS / EDITOR
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.pem

# =========================
# LOCAL TOOLING / SCRATCH  (not part of the app)
# =========================
.claude/
hero-section/
Prompt.txt

# =========================
# ROOT DOCS — keep ONLY README.md; everything else at the root
# (SECURITY.md, context.md, POKER.md, Audit*.md, Fixes*.md, and any
# future scratch notes) is a working doc and stays out of the repo.
# In-code docs like aon-server/ARCHITECTURE.md are NOT affected — this
# only matches Markdown at the repo root.
# =========================
/*.md
!/README.md
